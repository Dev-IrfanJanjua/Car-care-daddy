# Copy this file to .env.local and fill in real values once you have a Supabase project.
# Project Settings -> API in the Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL, used to build absolute booking links inside emails.
# Falls back to http://localhost:3000 when unset, so set it in production.
NEXT_PUBLIC_SITE_URL=

# Email confirmations + day-before reminders (Resend). Leave blank to no-op --
# booking creation and the reminder cron both treat email as best-effort.
RESEND_API_KEY=

# Shared secret the /api/cron/reminders route requires as `Authorization: Bearer <value>`.
# Route returns 401 if this is unset, so reminders fail closed by default.
CRON_SECRET=

# Not yet wired up -- reserved for a future Stripe deposit-at-booking feature.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
