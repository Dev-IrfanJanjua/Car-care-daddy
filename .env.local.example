# Copy this file to .env.local and fill in real values once you have a Supabase project.
# Project Settings -> API in the Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL, used to build absolute booking links inside emails.
# Falls back to http://localhost:3000 when unset, so set it in production.
NEXT_PUBLIC_SITE_URL=

# Email (Brevo). Customers are never emailed -- they confirm over WhatsApp from
# the success screen. The only mail this app sends is the new-booking alert to
# the shop, so these three are needed solely for ADMIN_EMAIL below.
# Blank is a no-op: sends are best-effort and never block a booking. Brevo's free
# tier is 300/day and authenticates a single sender address, no domain needed.
# Key: brevo.com -> SMTP & API -> API Keys.
BREVO_API_KEY=
# Must be verified under Senders, Domains & Dedicated IPs -> Senders. A personal
# Gmail works; Brevo refuses to relay from an unverified address.
BREVO_SENDER_EMAIL=
# Display name on outgoing mail. Defaults to "Car Care" when blank.
BREVO_SENDER_NAME=

# Where new-booking alerts are emailed. Blank disables the email alert only --
# the WhatsApp alert below is configured independently.
ADMIN_EMAIL=

# WhatsApp alerts to the shop on every new booking (CallMeBot, free).
# Setup: get the bot's current number from
#   https://www.callmebot.com/blog/free-api-whatsapp-messages/
# (it rotates, and signups are capped -- the page says when it is full), WhatsApp
# it the exact text
#   I allow callmebot to send me messages
# and it replies with your API key. Personal use only: it delivers to this one
# opted-in number and nowhere else, so it cannot message customers.
# Phone in full international format, e.g. +923001234567.
CALLMEBOT_PHONE=
CALLMEBOT_API_KEY=

# Shared secret the /api/cron/reminders route requires as `Authorization: Bearer <value>`.
# Route returns 401 if this is unset, so reminders fail closed by default.
CRON_SECRET=

# Not yet wired up -- reserved for a future Stripe deposit-at-booking feature.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
